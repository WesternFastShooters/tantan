{
  "openapi": "3.1.0",
  "info": {
    "title": "Tantan Local API",
    "version": "1.0.0",
    "description": "Phase-one loopback-only API. The implementation must bind 127.0.0.1:3000 and must not expose this API to LAN or public networks."
  },
  "servers": [{ "url": "http://127.0.0.1:3000", "description": "Local loopback" }],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Home" },
    { "name": "Search" },
    { "name": "AI" },
    { "name": "Sync" },
    { "name": "Ops" }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["Health"],
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": ["Health"],
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "SQLite migrations and Keychain capability are ready",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponse" } }
            }
          },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/auth/folo/start": {
      "get": {
        "tags": ["Auth"],
        "operationId": "startFoloAuth",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/Host" }],
        "responses": {
          "302": {
            "description": "Redirect to Folo login and set an HttpOnly SameSite=Lax flow cookie",
            "headers": {
              "Location": { "schema": { "type": "string", "format": "uri" } },
              "Set-Cookie": { "schema": { "type": "string" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/auth/folo/callback": {
      "get": {
        "tags": ["Auth"],
        "operationId": "completeFoloAuth",
        "description": "Consumes the one-time token returned by Folo and the local flow cookie. The Folo token and upstream session are never returned to the browser.",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 20, "maxLength": 4096 }
          },
          { "$ref": "#/components/parameters/Host" }
        ],
        "responses": {
          "302": {
            "description": "Create local session cookie and redirect to root",
            "headers": {
              "Location": { "schema": { "const": "/" } },
              "Set-Cookie": { "schema": { "type": "string" } }
            }
          },
          "400": { "$ref": "#/components/responses/AuthFlowInvalid" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "502": { "$ref": "#/components/responses/FoloUnavailable" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "operationId": "logout",
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "responses": {
          "204": {
            "description": "Local session and account-scoped Folo token are revoked; repeated calls are successful"
          },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/tantan/v1/session": {
      "get": {
        "tags": ["Auth"],
        "operationId": "getSession",
        "parameters": [{ "$ref": "#/components/parameters/Timezone" }],
        "responses": {
          "200": {
            "description": "Current local session",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/tantan/v1/home": {
      "get": {
        "tags": ["Home"],
        "operationId": "getHome",
        "parameters": [
          {
            "name": "topicId",
            "in": "query",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          {
            "name": "filterId",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Timezone" }
        ],
        "responses": {
          "200": {
            "description": "Stable persisted daily queue page; paging never re-ranks",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/home-response.schema.json" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "409": {
            "description": "Queue version changed; restart from the first page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/tantan/v1/topics": {
      "get": {
        "tags": ["Home"],
        "operationId": "getTopics",
        "responses": {
          "200": {
            "description": "Ordered visible topics with recommend as immutable first item",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TopicsResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      },
      "patch": {
        "tags": ["Home"],
        "operationId": "patchTopics",
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TopicPatchRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Updated ordered topics",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TopicsResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "409": { "$ref": "#/components/responses/VersionConflict" }
        }
      }
    },
    "/tantan/v1/filter": {
      "put": {
        "tags": ["Home", "AI"],
        "operationId": "putActiveFilter",
        "description": "Converts prompt to FilterSpec v1, validates AI output, builds a ready queue and activates filter/topics/queue in one transaction.",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/Timezone" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/FilterPutRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Filter, topics and ready queue are active",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FilterMutationResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "409": { "$ref": "#/components/responses/AINotConfigured" },
          "422": { "$ref": "#/components/responses/AIOutputInvalid" },
          "502": { "$ref": "#/components/responses/AIProviderUnavailable" }
        }
      },
      "delete": {
        "tags": ["Home"],
        "operationId": "deleteActiveFilter",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/Timezone" }
        ],
        "responses": {
          "200": {
            "description": "Default topics and default daily queue are active; repeated reset is successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FilterMutationResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/tantan/v1/recommendation/feedback": {
      "post": {
        "tags": ["Home"],
        "operationId": "postRecommendationFeedback",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback was applied exactly once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["applied"],
                  "properties": { "applied": { "const": true } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/tantan/v1/recommendation/blocks/sources": {
      "get": {
        "tags": ["Home"],
        "operationId": "listBlockedSources",
        "responses": {
          "200": {
            "description": "Currently blocked RSS Sources",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SourceBlocksResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/tantan/v1/recommendation/blocks/sources/{sourceId}": {
      "delete": {
        "tags": ["Home"],
        "operationId": "restoreBlockedSource",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          }
        ],
        "responses": {
          "200": {
            "description": "Source block was removed exactly once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["applied"],
                  "properties": { "applied": { "const": true } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/tantan/v1/search": {
      "get": {
        "tags": ["Search"],
        "operationId": "searchEntries",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Searches read and unread original/translated title, content, source, topic and tag fields without changing home state",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SearchResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/tantan/v1/entries/{entryId}/enrichment": {
      "parameters": [
        {
          "name": "entryId",
          "in": "path",
          "required": true,
          "schema": { "$ref": "#/components/schemas/Identifier" }
        }
      ],
      "get": {
        "tags": ["AI"],
        "operationId": "getEntryEnrichment",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "zh-CN",
              "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current enrichment state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnrichmentResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["AI"],
        "operationId": "ensureEntryEnrichment",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnrichmentEnsureRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "New or existing deduplicated enrichment job",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobAcceptedResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/AINotConfigured" }
        }
      }
    },
    "/tantan/v1/settings/ai-provider": {
      "get": {
        "tags": ["AI"],
        "operationId": "getAIProviderSettings",
        "responses": {
          "200": {
            "description": "Non-secret provider settings; API key is never returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AIProviderResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      },
      "put": {
        "tags": ["AI"],
        "operationId": "putAIProviderSettings",
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AIProviderPutRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings and optional Keychain secret were atomically saved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AIProviderResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "500": { "$ref": "#/components/responses/LocalStorageError" }
        }
      },
      "delete": {
        "tags": ["AI"],
        "operationId": "deleteAIProviderSettings",
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "responses": {
          "204": {
            "description": "Keychain key is deleted before non-secret config; repeated calls are successful"
          },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "500": { "$ref": "#/components/responses/LocalStorageError" }
        }
      }
    },
    "/tantan/v1/settings/ai-provider/test": {
      "post": {
        "tags": ["AI"],
        "operationId": "testAIProviderSettings",
        "description": "Tests a temporary preset provider configuration without persisting the key. Limited to three requests per minute per local session.",
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AIProviderTestRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider responded successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AIProviderTestResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/AIProviderUnavailable" }
        }
      }
    },
    "/tantan/v1/sync/status": {
      "get": {
        "tags": ["Sync"],
        "operationId": "getSyncStatus",
        "responses": {
          "200": {
            "description": "Current or most recent sync state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SyncStatusResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/tantan/v1/sync": {
      "post": {
        "tags": ["Sync"],
        "operationId": "triggerSync",
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SyncTriggerRequest" } }
          }
        },
        "responses": {
          "202": {
            "description": "New or existing non-terminal job for the same scope",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobAcceptedResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/tantan/v1/diagnostics": {
      "get": {
        "tags": ["Ops"],
        "operationId": "getDiagnostics",
        "description": "Returns local redacted diagnostics only. It never returns content, prompts, cookies, tokens or API keys.",
        "responses": {
          "200": {
            "description": "Redacted local diagnostics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DiagnosticsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tantan_session",
        "description": "HttpOnly SameSite=Lax local session. Server stores only SHA-256 hash."
      }
    },
    "parameters": {
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "http://127.0.0.1:3000",
            "http://127.0.0.1:5173",
            "http://localhost:3000",
            "http://localhost:5173"
          ]
        }
      },
      "Host": {
        "name": "Host",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "enum": ["127.0.0.1:3000", "localhost:3000"]
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "Timezone": {
        "name": "X-Tantan-Timezone",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "default": "Asia/Shanghai", "maxLength": 64 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "minLength": 16, "maxLength": 2048 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
      }
    },
    "schemas": {
      "Identifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "version"],
        "properties": {
          "status": { "const": "ok" },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ready", "checks"],
        "properties": {
          "ready": { "type": "boolean" },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sqlite", "migrations", "keychain"],
            "properties": {
              "sqlite": { "type": "string", "enum": ["ok", "error"] },
              "migrations": { "type": "string", "enum": ["ok", "error"] },
              "keychain": { "type": "string", "enum": ["ok", "error"] }
            }
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "timezone"],
        "properties": {
          "user": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "email", "image"],
            "properties": {
              "id": { "$ref": "#/components/schemas/Identifier" },
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "email": { "type": ["string", "null"], "format": "email", "maxLength": 320 },
              "image": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 }
            }
          },
          "timezone": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "Topic": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "fixed", "pinned", "hidden", "unreadCount"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Identifier" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "kind": { "type": "string", "enum": ["virtual", "core", "dynamic", "filter"] },
          "fixed": { "type": "boolean" },
          "pinned": { "type": "boolean" },
          "hidden": { "type": "boolean" },
          "unreadCount": { "type": "integer", "minimum": 0 }
        }
      },
      "TopicsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "activeFilterId", "topics"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "activeFilterId": { "type": ["string", "null"], "maxLength": 128 },
          "topics": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/Topic" }
          }
        }
      },
      "TopicPatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "operations"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["op", "topicId"],
              "properties": {
                "op": { "type": "string", "enum": ["pin", "unpin", "hide", "show", "move"] },
                "topicId": { "$ref": "#/components/schemas/Identifier" },
                "afterTopicId": { "type": ["string", "null"], "maxLength": 128 }
              }
            }
          }
        }
      },
      "FilterPutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt"],
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      },
      "FilterMutationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filter", "topics", "queueId"],
        "properties": {
          "filter": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "prompt", "createdAt"],
            "properties": {
              "id": { "$ref": "#/components/schemas/Identifier" },
              "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          },
          "topics": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/Topic" }
          },
          "queueId": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "FeedbackRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "action"],
        "properties": {
          "entryId": { "$ref": "#/components/schemas/Identifier" },
          "action": {
            "type": "string",
            "enum": ["not_interested", "block_source", "block_topic", "undo"]
          },
          "topicId": { "type": ["string", "null"], "maxLength": 128 }
        }
      },
      "SourceBlock": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "name", "createdAt"],
        "properties": {
          "sourceId": { "$ref": "#/components/schemas/Identifier" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SourceBlocksResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 500,
            "items": { "$ref": "#/components/schemas/SourceBlock" }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor", "indexStatus"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": { "$ref": "../schemas/home-response.schema.json#/$defs/homeCard" }
          },
          "nextCursor": { "type": ["string", "null"], "maxLength": 2048 },
          "indexStatus": { "type": "string", "enum": ["building", "ready", "degraded"] }
        }
      },
      "EnrichmentEnsureRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fields", "language"],
        "properties": {
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["translation", "summary", "keyPoints", "topics"] }
          },
          "language": {
            "type": "string",
            "default": "zh-CN",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          }
        }
      },
      "EnrichmentResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "data", "error"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["missing", "queued", "processing", "ready", "failed"]
          },
          "data": {
            "oneOf": [{ "$ref": "../schemas/ai-enrichment-v1.schema.json" }, { "type": "null" }]
          },
          "error": {
            "oneOf": [{ "$ref": "#/components/schemas/ErrorObject" }, { "type": "null" }]
          }
        }
      },
      "AIProviderId": {
        "type": "string",
        "enum": ["openai", "anthropic", "google", "deepseek", "openrouter"]
      },
      "AIProviderPutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerId", "model"],
        "properties": {
          "providerId": { "$ref": "#/components/schemas/AIProviderId" },
          "model": { "type": "string", "minLength": 1, "maxLength": 100 },
          "apiKey": { "type": "string", "minLength": 8, "maxLength": 4096, "writeOnly": true }
        }
      },
      "AIProviderTestRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerId", "model", "apiKey"],
        "properties": {
          "providerId": { "$ref": "#/components/schemas/AIProviderId" },
          "model": { "type": "string", "minLength": 1, "maxLength": 100 },
          "apiKey": { "type": "string", "minLength": 8, "maxLength": 4096, "writeOnly": true }
        }
      },
      "AIProviderResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["configured", "providerId", "model", "baseUrl", "hasApiKey", "keyFingerprint"],
        "properties": {
          "configured": { "type": "boolean" },
          "providerId": {
            "oneOf": [{ "$ref": "#/components/schemas/AIProviderId" }, { "type": "null" }]
          },
          "model": { "type": ["string", "null"], "maxLength": 100 },
          "baseUrl": { "type": ["string", "null"], "format": "uri", "readOnly": true },
          "hasApiKey": { "type": "boolean" },
          "keyFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{12}$" }
        }
      },
      "AIProviderTestResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "latencyMs", "model"],
        "properties": {
          "ok": { "const": true },
          "latencyMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
          "model": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      },
      "SyncTriggerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope"],
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["all", "subscriptions", "entries", "reads", "collections"]
          }
        }
      },
      "JobAcceptedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jobId", "state"],
        "properties": {
          "jobId": { "$ref": "#/components/schemas/Identifier" },
          "state": { "type": "string", "enum": ["queued", "running"] }
        }
      },
      "SyncStatusResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "scope", "counts", "error", "updatedAt"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["idle", "queued", "running", "succeeded", "failed"]
          },
          "scope": {
            "type": ["string", "null"],
            "enum": ["all", "subscriptions", "entries", "reads", "collections", null]
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["processed", "total", "failed"],
            "properties": {
              "processed": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 }
            }
          },
          "error": {
            "oneOf": [{ "$ref": "#/components/schemas/ErrorObject" }, { "type": "null" }]
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "DiagnosticsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "database", "jobs", "sync", "deniedFoloRoutes"],
        "properties": {
          "version": { "type": "string", "maxLength": 64 },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "sizeBytes", "integrity"],
            "properties": {
              "schemaVersion": { "type": "integer", "minimum": 0 },
              "sizeBytes": { "type": "integer", "minimum": 0 },
              "integrity": { "type": "string", "enum": ["ok", "unknown", "error"] }
            }
          },
          "jobs": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "sync": { "$ref": "#/components/schemas/SyncStatusResponse" },
          "deniedFoloRoutes": { "type": "integer", "minimum": 0 }
        }
      },
      "ErrorObject": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "AUTH_REQUIRED",
              "AUTH_FLOW_INVALID",
              "ORIGIN_REJECTED",
              "FOLO_ROUTE_NOT_ALLOWED",
              "FOLO_FEATURE_REMOVED",
              "FOLO_UNAVAILABLE",
              "FOLO_RATE_LIMITED",
              "AI_NOT_CONFIGURED",
              "AI_PROVIDER_UNAVAILABLE",
              "AI_OUTPUT_INVALID",
              "LOCAL_STORAGE_ERROR",
              "VALIDATION_ERROR",
              "VERSION_CONFLICT",
              "CURSOR_MISMATCH",
              "QUEUE_VERSION_CHANGED",
              "NOT_FOUND",
              "RATE_LIMITED",
              "SERVICE_NOT_READY"
            ]
          },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 },
          "fieldErrors": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "reason"],
              "properties": {
                "field": { "type": "string", "maxLength": 128 },
                "reason": { "type": "string", "maxLength": 300 }
              }
            }
          },
          "retryAfterMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
          "currentVersion": { "type": "integer", "minimum": 1 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "error"],
        "properties": {
          "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
          "error": { "$ref": "#/components/schemas/ErrorObject" }
        }
      }
    },
    "responses": {
      "AuthRequired": {
        "description": "AUTH_REQUIRED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AuthFlowInvalid": {
        "description": "AUTH_FLOW_INVALID",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "OriginRejected": {
        "description": "ORIGIN_REJECTED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "ValidationError": {
        "description": "VALIDATION_ERROR or CURSOR_MISMATCH",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "VersionConflict": {
        "description": "VERSION_CONFLICT",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "FoloUnavailable": {
        "description": "FOLO_UNAVAILABLE",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AINotConfigured": {
        "description": "AI_NOT_CONFIGURED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AIProviderUnavailable": {
        "description": "AI_PROVIDER_UNAVAILABLE",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AIOutputInvalid": {
        "description": "AI_OUTPUT_INVALID; prior filter, topics and queue remain active",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "LocalStorageError": {
        "description": "LOCAL_STORAGE_ERROR",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "NotFound": {
        "description": "NOT_FOUND",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "RateLimited": {
        "description": "RATE_LIMITED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "ServiceUnavailable": {
        "description": "SERVICE_NOT_READY",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      }
    }
  },
  "security": [{ "LocalSession": [] }]
}
