{
  "openapi": "3.1.0",
  "info": {
    "title": "Tantan Mobile Web API",
    "version": "2.0.0",
    "description": "Same-origin API for the deployable Tantan Mobile Web/PWA. Production TLS terminates at a trusted reverse proxy and the Go service listens on an internal loopback address."
  },
  "servers": [{ "url": "/", "description": "Current Tantan origin" }],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Home" },
    { "name": "Search" },
    { "name": "AI" },
    { "name": "Sync" },
    { "name": "Ops" }
  ],
  "paths": {
    "/api/healthz": {
      "get": {
        "tags": ["Health"],
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/api/readyz": {
      "get": {
        "tags": ["Health"],
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "SQLite migrations, secret store, route policy and static assets are ready",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ReadinessResponse" } }
            }
          },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/auth/folo/providers": {
      "get": {
        "tags": ["Auth"],
        "operationId": "listFoloAuthProviders",
        "security": [],
        "responses": {
          "200": {
            "description": "Folo-compatible login methods in display order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FoloAuthProvidersResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/folo/social-start": {
      "post": {
        "tags": ["Auth"],
        "operationId": "startFoloSocialLogin",
        "description": "Returns a fixed official Folo login URL. Tantan never accepts a user-provided OAuth or callback URL.",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FoloSocialStartRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Open the official Folo URL in a new browser tab",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FoloSocialStartResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/api/auth/folo/token": {
      "post": {
        "tags": ["Auth"],
        "operationId": "applyFoloAuthorizationToken",
        "description": "Exchanges a single-use Folo token obtained after any official Folo login method and seals the returned Folo session.",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FoloTokenLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tantan session created",
            "headers": { "Set-Cookie": { "schema": { "type": "string", "writeOnly": true } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthInvalid" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "409": { "$ref": "#/components/responses/AuthTokenUsed" },
          "503": { "$ref": "#/components/responses/FoloUnavailable" }
        }
      }
    },
    "/api/auth/folo/email": {
      "post": {
        "tags": ["Auth"],
        "operationId": "signInFoloEmail",
        "description": "Authenticates with Folo from Go, seals the upstream session token and returns only a Tantan session cookie and public user DTO.",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FoloEmailLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tantan session created",
            "headers": { "Set-Cookie": { "schema": { "type": "string", "writeOnly": true } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthInvalid" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "409": { "$ref": "#/components/responses/AuthTwoFactorRequired" },
          "503": { "$ref": "#/components/responses/FoloUnavailable" }
        }
      }
    },
    "/api/auth/folo/two-factor": {
      "post": {
        "tags": ["Auth"],
        "operationId": "verifyFoloEmailTwoFactor",
        "description": "Completes a pending Folo Email TOTP challenge held only in Go memory. The pending upstream cookie is never returned to the browser.",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/Origin" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FoloTwoFactorVerifyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tantan session created",
            "headers": { "Set-Cookie": { "schema": { "type": "string", "writeOnly": true } } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthInvalid" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "410": { "$ref": "#/components/responses/AuthFlowInvalid" },
          "503": { "$ref": "#/components/responses/FoloUnavailable" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "operationId": "logout",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "204": {
            "description": "Tantan session and account-scoped sealed Folo token are revoked; repeated calls are successful"
          },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/api/tantan/v1/session": {
      "get": {
        "tags": ["Auth"],
        "operationId": "getSession",
        "parameters": [{ "$ref": "#/components/parameters/Timezone" }],
        "responses": {
          "200": {
            "description": "Current Tantan session",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SessionResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/api/tantan/v1/home": {
      "get": {
        "tags": ["Home"],
        "operationId": "getHome",
        "parameters": [
          {
            "name": "topicId",
            "in": "query",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          {
            "name": "filterId",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Timezone" }
        ],
        "responses": {
          "200": {
            "description": "Stable persisted daily queue page; paging never re-ranks",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/home-response.schema.json" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "409": {
            "description": "Queue version changed; restart from the first page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/api/tantan/v1/content-pool": {
      "get": {
        "tags": ["Home"],
        "operationId": "getContentPool",
        "description": "Returns only original Chinese entries or non-Chinese entries whose current content has a completed Chinese translation. Raw untranslated text is never returned.",
        "parameters": [
          {
            "name": "sourceId",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          },
          { "$ref": "#/components/parameters/Cursor" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 20, "default": 20 }
          },
          { "$ref": "#/components/parameters/Timezone" }
        ],
        "responses": {
          "200": {
            "description": "Stable translated content pool page and translation progress",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContentPoolResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/api/tantan/v1/topics": {
      "get": {
        "tags": ["Home"],
        "operationId": "getTopics",
        "responses": {
          "200": {
            "description": "Ordered visible topics with recommend as immutable first item",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TopicsResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      },
      "patch": {
        "tags": ["Home"],
        "operationId": "patchTopics",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TopicPatchRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Updated ordered topics",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TopicsResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "409": { "$ref": "#/components/responses/VersionConflict" }
        }
      }
    },
    "/api/tantan/v1/filter": {
      "put": {
        "tags": ["Home", "AI"],
        "operationId": "putActiveFilter",
        "description": "Converts prompt to FilterSpec v1, validates AI output, builds a ready queue and activates filter/topics/queue in one transaction.",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/Timezone" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/FilterPutRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Filter, topics and ready queue are active",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FilterMutationResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "409": { "$ref": "#/components/responses/AINotConfigured" },
          "422": { "$ref": "#/components/responses/AIOutputInvalid" },
          "502": { "$ref": "#/components/responses/AIProviderUnavailable" }
        }
      },
      "delete": {
        "tags": ["Home"],
        "operationId": "deleteActiveFilter",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" },
          { "$ref": "#/components/parameters/Timezone" }
        ],
        "responses": {
          "200": {
            "description": "Default topics and default daily queue are active; repeated reset is successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FilterMutationResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/api/tantan/v1/recommendation/feedback": {
      "post": {
        "tags": ["Home"],
        "operationId": "postRecommendationFeedback",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/FeedbackRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback was applied exactly once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["applied"],
                  "properties": { "applied": { "const": true } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/api/tantan/v1/recommendation/blocks/sources": {
      "get": {
        "tags": ["Home"],
        "operationId": "listBlockedSources",
        "responses": {
          "200": {
            "description": "Currently blocked RSS Sources",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SourceBlocksResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/api/tantan/v1/recommendation/blocks/sources/{sourceId}": {
      "delete": {
        "tags": ["Home"],
        "operationId": "restoreBlockedSource",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/Identifier" }
          }
        ],
        "responses": {
          "200": {
            "description": "Source block was removed exactly once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["applied"],
                  "properties": { "applied": { "const": true } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/tantan/v1/search": {
      "get": {
        "tags": ["Search"],
        "operationId": "searchEntries",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Searches read and unread original/translated title, content, source, topic and tag fields without changing home state",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SearchResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/api/tantan/v1/entries/{entryId}/enrichment": {
      "parameters": [
        {
          "name": "entryId",
          "in": "path",
          "required": true,
          "schema": { "$ref": "#/components/schemas/Identifier" }
        }
      ],
      "get": {
        "tags": ["AI"],
        "operationId": "getEntryEnrichment",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "zh-CN",
              "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current enrichment state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnrichmentResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["AI"],
        "operationId": "ensureEntryEnrichment",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnrichmentEnsureRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "New or existing deduplicated enrichment job",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobAcceptedResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/AINotConfigured" }
        }
      }
    },
    "/api/tantan/v1/settings/ai-provider": {
      "get": {
        "tags": ["AI"],
        "operationId": "getAIProviderSettings",
        "responses": {
          "200": {
            "description": "Read-only status for the server-owned Gemini preset; the API key is never accepted from or returned to a browser",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AIProviderResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/api/tantan/v1/settings/ai-provider/test": {
      "post": {
        "tags": ["AI"],
        "operationId": "testAIProviderSettings",
        "description": "Tests the fixed server-owned Gemini configuration. No key, model or endpoint is accepted from the browser. Limited to three requests per minute per local session.",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "200": {
            "description": "Provider responded successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AIProviderTestResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/AIProviderUnavailable" }
        }
      }
    },
    "/api/tantan/v1/sync/status": {
      "get": {
        "tags": ["Sync"],
        "operationId": "getSyncStatus",
        "responses": {
          "200": {
            "description": "Current or most recent sync state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SyncStatusResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/api/tantan/v1/sync": {
      "post": {
        "tags": ["Sync"],
        "operationId": "triggerSync",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SyncTriggerRequest" } }
          }
        },
        "responses": {
          "202": {
            "description": "New or existing non-terminal job for the same scope",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobAcceptedResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "403": { "$ref": "#/components/responses/OriginRejected" }
        }
      }
    },
    "/api/tantan/v1/diagnostics": {
      "get": {
        "tags": ["Ops"],
        "operationId": "getDiagnostics",
        "description": "Returns local redacted diagnostics only. It never returns content, prompts, cookies, tokens or API keys.",
        "responses": {
          "200": {
            "description": "Redacted local diagnostics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DiagnosticsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-tantan_session",
        "description": "Secure HttpOnly SameSite=Lax Tantan session. The upstream Folo token is separately sealed and never returned."
      }
    },
    "parameters": {
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "description": "Must exactly equal the configured public_origin; production requires HTTPS.",
        "schema": { "type": "string", "format": "uri", "maxLength": 2048 }
      },
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 32, "maxLength": 256 }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "Timezone": {
        "name": "X-Tantan-Timezone",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "default": "Asia/Shanghai", "maxLength": 64 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "minLength": 16, "maxLength": 2048 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
      }
    },
    "schemas": {
      "Identifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "version"],
        "properties": {
          "status": { "const": "ok" },
          "version": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ready", "checks"],
        "properties": {
          "ready": { "type": "boolean" },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sqlite", "migrations", "secretStore", "routePolicy", "staticAssets"],
            "properties": {
              "sqlite": { "type": "string", "enum": ["ok", "error"] },
              "migrations": { "type": "string", "enum": ["ok", "error"] },
              "secretStore": { "type": "string", "enum": ["ok", "error"] },
              "routePolicy": { "type": "string", "enum": ["ok", "error"] },
              "staticAssets": { "type": "string", "enum": ["ok", "error"] }
            }
          }
        }
      },
      "FoloAuthProvider": {
        "type": "string",
        "enum": ["google", "github", "apple", "credential", "token"]
      },
      "FoloAuthProvidersResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providers"],
        "properties": {
          "providers": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": { "$ref": "#/components/schemas/FoloAuthProvider" }
          }
        }
      },
      "FoloSocialStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider"],
        "properties": {
          "provider": { "type": "string", "enum": ["google", "github", "apple"] }
        }
      },
      "FoloSocialStartResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorizeUrl", "handoff"],
        "properties": {
          "authorizeUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://app\\.folo\\.is/login\\?provider=(google|github|apple)$"
          },
          "handoff": { "type": "string", "const": "one-time-token" }
        }
      },
      "FoloTokenLoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": { "type": "string", "minLength": 20, "maxLength": 4096, "writeOnly": true },
          "returnTo": { "type": "string", "pattern": "^/[A-Za-z0-9/_?&=.%:-]*$", "maxLength": 1024 }
        }
      },
      "FoloEmailLoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "minLength": 8, "maxLength": 128, "writeOnly": true },
          "returnTo": { "type": "string", "pattern": "^/[A-Za-z0-9/_?&=.%:-]*$", "maxLength": 1024 }
        }
      },
      "FoloTwoFactorVerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flowId", "code"],
        "properties": {
          "flowId": { "$ref": "#/components/schemas/Identifier" },
          "code": { "type": "string", "pattern": "^[0-9]{6,10}$", "writeOnly": true }
        }
      },
      "FoloTwoFactorChallengeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "error", "challenge"],
        "properties": {
          "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
          "error": {
            "allOf": [
              { "$ref": "#/components/schemas/ErrorObject" },
              {
                "type": "object",
                "properties": { "code": { "const": "AUTH_2FA_REQUIRED" } }
              }
            ]
          },
          "challenge": {
            "type": "object",
            "additionalProperties": false,
            "required": ["flowId", "expiresAt"],
            "properties": {
              "flowId": { "$ref": "#/components/schemas/Identifier" },
              "expiresAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "timezone", "csrfToken"],
        "properties": {
          "user": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "email", "image"],
            "properties": {
              "id": { "$ref": "#/components/schemas/Identifier" },
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "email": { "type": ["string", "null"], "format": "email", "maxLength": 320 },
              "image": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 }
            }
          },
          "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
          "csrfToken": { "type": "string", "minLength": 32, "maxLength": 256, "writeOnly": false }
        }
      },
      "Topic": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "fixed", "pinned", "hidden", "unreadCount"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Identifier" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "kind": { "type": "string", "enum": ["virtual", "core", "dynamic", "filter"] },
          "fixed": { "type": "boolean" },
          "pinned": { "type": "boolean" },
          "hidden": { "type": "boolean" },
          "unreadCount": { "type": "integer", "minimum": 0 }
        }
      },
      "TopicsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "topicsRevision", "activeFilterId", "topics"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "topicsRevision": { "type": "integer", "minimum": 1 },
          "activeFilterId": { "type": ["string", "null"], "maxLength": 128 },
          "topics": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/Topic" }
          }
        }
      },
      "TopicPatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "operations"],
        "properties": {
          "version": { "type": "integer", "minimum": 1 },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["op", "topicId"],
              "properties": {
                "op": { "type": "string", "enum": ["pin", "unpin", "hide", "show", "move"] },
                "topicId": { "$ref": "#/components/schemas/Identifier" },
                "afterTopicId": { "type": ["string", "null"], "maxLength": 128 }
              }
            }
          }
        }
      },
      "FilterPutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt"],
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      },
      "FilterMutationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filter", "topics", "topicsRevision", "queueId", "queueGeneration"],
        "properties": {
          "filter": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "prompt", "createdAt"],
            "properties": {
              "id": { "$ref": "#/components/schemas/Identifier" },
              "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          },
          "topics": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/Topic" }
          },
          "topicsRevision": { "type": "integer", "minimum": 1 },
          "queueId": { "$ref": "#/components/schemas/Identifier" },
          "queueGeneration": { "$ref": "#/components/schemas/Identifier" }
        }
      },
      "FeedbackRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "action"],
        "properties": {
          "entryId": { "$ref": "#/components/schemas/Identifier" },
          "action": {
            "type": "string",
            "enum": ["not_interested", "block_source", "block_topic", "undo"]
          },
          "topicId": { "type": ["string", "null"], "maxLength": 128 }
        }
      },
      "SourceBlock": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "name", "createdAt"],
        "properties": {
          "sourceId": { "$ref": "#/components/schemas/Identifier" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SourceBlocksResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 500,
            "items": { "$ref": "#/components/schemas/SourceBlock" }
          }
        }
      },
      "ContentPoolResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor", "pool"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "../schemas/home-response.schema.json#/$defs/homeCard" }
          },
          "nextCursor": { "type": ["string", "null"], "maxLength": 2048 },
          "pool": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "ready", "pending"],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "ready": { "type": "integer", "minimum": 0 },
              "pending": { "type": "integer", "minimum": 0 }
            }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor", "indexStatus"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": { "$ref": "../schemas/home-response.schema.json#/$defs/homeCard" }
          },
          "nextCursor": { "type": ["string", "null"], "maxLength": 2048 },
          "indexStatus": { "type": "string", "enum": ["building", "ready", "degraded"] }
        }
      },
      "EnrichmentEnsureRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fields", "language"],
        "properties": {
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["translation", "summary", "keyPoints", "topics"] }
          },
          "language": {
            "type": "string",
            "default": "zh-CN",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          }
        }
      },
      "EnrichmentResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "data", "error"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["missing", "queued", "processing", "ready", "failed"]
          },
          "data": {
            "oneOf": [{ "$ref": "../schemas/ai-enrichment-v1.schema.json" }, { "type": "null" }]
          },
          "error": {
            "oneOf": [{ "$ref": "#/components/schemas/ErrorObject" }, { "type": "null" }]
          }
        }
      },
      "AIProviderId": {
        "type": "string",
        "enum": ["google-gemini-openai"]
      },
      "AIProviderResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["configured", "providerId", "model", "baseUrl", "hasApiKey", "keyFingerprint"],
        "properties": {
          "configured": { "type": "boolean" },
          "providerId": {
            "oneOf": [{ "$ref": "#/components/schemas/AIProviderId" }, { "type": "null" }]
          },
          "model": {
            "oneOf": [{ "type": "string", "const": "gemini-3.5-flash-lite" }, { "type": "null" }]
          },
          "baseUrl": {
            "oneOf": [
              {
                "type": "string",
                "const": "https://generativelanguage.googleapis.com/v1beta/openai"
              },
              { "type": "null" }
            ],
            "readOnly": true
          },
          "hasApiKey": { "type": "boolean" },
          "keyFingerprint": {
            "oneOf": [{ "type": "string", "pattern": "^[A-F0-9]{8}$" }, { "type": "null" }],
            "readOnly": true
          }
        }
      },
      "AIProviderTestResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "latencyMs", "model"],
        "properties": {
          "ok": { "const": true },
          "latencyMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
          "model": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      },
      "SyncTriggerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope"],
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["all", "subscriptions", "entries", "reads", "collections"]
          }
        }
      },
      "JobAcceptedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jobId", "state"],
        "properties": {
          "jobId": { "$ref": "#/components/schemas/Identifier" },
          "state": { "type": "string", "enum": ["queued", "running"] }
        }
      },
      "SyncStatusResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "scope", "counts", "error", "updatedAt"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["idle", "queued", "running", "succeeded", "failed"]
          },
          "scope": {
            "type": ["string", "null"],
            "enum": ["all", "subscriptions", "entries", "reads", "collections", null]
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["processed", "total", "failed"],
            "properties": {
              "processed": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 }
            }
          },
          "error": {
            "oneOf": [{ "$ref": "#/components/schemas/ErrorObject" }, { "type": "null" }]
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "DiagnosticsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "database", "jobs", "sync", "deniedFoloRoutes"],
        "properties": {
          "version": { "type": "string", "maxLength": 64 },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "sizeBytes", "integrity"],
            "properties": {
              "schemaVersion": { "type": "integer", "minimum": 0 },
              "sizeBytes": { "type": "integer", "minimum": 0 },
              "integrity": { "type": "string", "enum": ["ok", "unknown", "error"] }
            }
          },
          "jobs": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "sync": { "$ref": "#/components/schemas/SyncStatusResponse" },
          "deniedFoloRoutes": { "type": "integer", "minimum": 0 }
        }
      },
      "ErrorObject": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "AUTH_REQUIRED",
              "SESSION_REQUIRED",
              "AUTH_INVALID",
              "AUTH_2FA_REQUIRED",
              "AUTH_PROVIDER_INVALID",
              "AUTH_TOKEN_USED",
              "AUTH_FLOW_INVALID",
              "ORIGIN_REJECTED",
              "CSRF_INVALID",
              "FOLO_ROUTE_DENIED",
              "FOLO_ROUTE_NOT_ALLOWED",
              "FOLO_FEATURE_REMOVED",
              "FOLO_UNAVAILABLE",
              "FOLO_RATE_LIMITED",
              "AI_NOT_CONFIGURED",
              "AI_PRESET_INVALID",
              "AI_AUTH_FAILED",
              "AI_RATE_LIMITED",
              "AI_PROVIDER_UNAVAILABLE",
              "AI_OUTPUT_INVALID",
              "LOCAL_STORAGE_ERROR",
              "DB_BUSY",
              "VALIDATION_ERROR",
              "VERSION_CONFLICT",
              "CURSOR_MISMATCH",
              "QUEUE_VERSION_CHANGED",
              "NOT_FOUND",
              "RATE_LIMITED",
              "SERVICE_NOT_READY"
            ]
          },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 },
          "retryable": { "type": "boolean" },
          "fieldErrors": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "reason"],
              "properties": {
                "field": { "type": "string", "maxLength": 128 },
                "reason": { "type": "string", "maxLength": 300 }
              }
            }
          },
          "retryAfterMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
          "currentVersion": { "type": "integer", "minimum": 1 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "error"],
        "properties": {
          "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
          "error": { "$ref": "#/components/schemas/ErrorObject" }
        }
      }
    },
    "responses": {
      "AuthRequired": {
        "description": "AUTH_REQUIRED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AuthInvalid": {
        "description": "AUTH_INVALID",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AuthTwoFactorRequired": {
        "description": "AUTH_2FA_REQUIRED",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/FoloTwoFactorChallengeResponse" }
          }
        }
      },
      "AuthTokenUsed": {
        "description": "AUTH_TOKEN_USED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AuthFlowInvalid": {
        "description": "AUTH_FLOW_INVALID",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "OriginRejected": {
        "description": "ORIGIN_REJECTED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "ValidationError": {
        "description": "VALIDATION_ERROR or CURSOR_MISMATCH",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "VersionConflict": {
        "description": "VERSION_CONFLICT",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "FoloUnavailable": {
        "description": "FOLO_UNAVAILABLE",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AINotConfigured": {
        "description": "AI_NOT_CONFIGURED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AIProviderUnavailable": {
        "description": "AI_PROVIDER_UNAVAILABLE",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "AIOutputInvalid": {
        "description": "AI_OUTPUT_INVALID; prior filter, topics and queue remain active",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "LocalStorageError": {
        "description": "LOCAL_STORAGE_ERROR",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "NotFound": {
        "description": "NOT_FOUND",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "RateLimited": {
        "description": "RATE_LIMITED",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "ServiceUnavailable": {
        "description": "SERVICE_NOT_READY",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      }
    }
  },
  "security": [{ "LocalSession": [] }]
}
