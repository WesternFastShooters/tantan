{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tantan.local/schemas/ai-enrichment-v1.schema.json",
  "title": "AIEnrichmentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "detectedLanguage", "titleZh", "contentZh", "summaryZh", "keyPoints"],
  "properties": {
    "version": { "const": 1 },
    "detectedLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "titleZh": { "type": ["string", "null"], "maxLength": 500 },
    "contentZh": { "type": ["string", "null"], "maxLength": 100000 },
    "summaryZh": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "keyPoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
